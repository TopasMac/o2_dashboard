# Copy this file to .env.local and replace the local-only placeholder secrets.
# Never put production credentials in this file.

APP_SECRET=replace-with-a-random-local-secret

OWNERS2_DB_NAME=owners2_dev
OWNERS2_DB_USER=owners2
OWNERS2_DB_PASSWORD=replace-with-a-local-database-password
OWNERS2_DB_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL="mysql://owners2:replace-with-a-local-database-password@127.0.0.1:3308/owners2_dev?serverVersion=8.0.43&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=replace-with-a-local-jwt-passphrase

MAILER_DSN=smtp://127.0.0.1:1025
MESSENGER_TRANSPORT_DSN=sync://
VAR_DUMPER_SERVER=

AWS_ACCESS_KEY_ID=local-disabled
AWS_SECRET_ACCESS_KEY=local-disabled
AWS_S3_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
CDN_BUCKET=owners2-local-disabled
CDN_BASE=http://127.0.0.1:9000
CDN_ORIGIN_PREFIX=local
